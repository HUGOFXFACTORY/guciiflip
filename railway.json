{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm rebuild better-sqlite3",
    "nixpacksPlan": {
      "aptPkgs": ["python3", "make", "g++", "gcc"]
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "numReplicas": 1,
    "sleepApplication": false
  }
}
